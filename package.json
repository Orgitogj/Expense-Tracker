{
  "name": "expense-tracker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "scripts": {
    "mobile:start": "npm run start --workspace @expense-tracker/mobile",
    "mobile:android": "npm run android --workspace @expense-tracker/mobile",
    "mobile:ios": "npm run ios --workspace @expense-tracker/mobile",
    "mobile:web": "npm run web --workspace @expense-tracker/mobile",
    "mobile:test": "npm run test --workspace @expense-tracker/mobile",
    "api:dev": "npm run dev --workspace @expense-tracker/api",
    "api:build": "npm run build --workspace @expense-tracker/api",
    "api:start": "npm run start --workspace @expense-tracker/api",
    "api:test": "npm run test --workspace @expense-tracker/api",
    "api:test:integration": "npm run test:integration --workspace @expense-tracker/api",
    "api:prisma:validate": "npm run prisma:validate --workspace @expense-tracker/api",
    "api:prisma:generate": "npm run prisma:generate --workspace @expense-tracker/api",
    "api:prisma:migrate:dev": "npm run prisma:migrate:dev --workspace @expense-tracker/api",
    "api:prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @expense-tracker/api",
    "api:prisma:migrate:status": "npm run prisma:migrate:status --workspace @expense-tracker/api",
    "db:up": "docker compose -f apps/api/compose.yaml up -d --wait postgres",
    "db:stop": "docker compose -f apps/api/compose.yaml stop",
    "db:down": "docker compose -f apps/api/compose.yaml down",
    "db:logs": "docker compose -f apps/api/compose.yaml logs -f postgres",
    "db:test:up": "docker compose -f apps/api/compose.yaml --profile test up -d --wait postgres-test",
    "db:test:down": "docker compose -f apps/api/compose.yaml --profile test rm --stop --force postgres-test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test && npm run format:check"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
