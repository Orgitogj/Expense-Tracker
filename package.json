{
  "name": "expense-tracker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || >=24.3.0"
  },
  "scripts": {
    "mobile:start": "npm run start --workspace @expense-tracker/mobile",
    "mobile:android": "npm run android --workspace @expense-tracker/mobile",
    "mobile:ios": "npm run ios --workspace @expense-tracker/mobile",
    "mobile:web": "npm run web --workspace @expense-tracker/mobile",
    "lint": "npm run lint --workspaces --if-present"
  }
}
